# Copy to .env (git-ignored) and fill in your own keys. Never commit .env.

# NASA FIRMS fire detections (required). Free: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=

# OpenAQ, government (CPCB) PM2.5 history (required). Free: https://explore.openaq.org/register
OPENAQ_API_KEY=

# data.gov.in live CPCB feed (optional; the app does not use the live feed at present)
DATA_GOV_IN_API_KEY=
